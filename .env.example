# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# MANaja AI: OpenAI-compatible API base URL (must include /v1 or equivalent)
MANAJA_API_BASE_URL=https://your-manaja-endpoint.example/v1
MANAJA_API_KEY=
MANAJA_MODEL=your-model-id
MANAJA_TIMEOUT_SECONDS=45

# Sheets integration (share target spreadsheet with this service-account email)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET_LEADS=Leads

# Optional operating settings
LEAD_NOTIFICATION_WEBHOOK=
CONVERSATION_RETENTION_DAYS=90
RATE_LIMIT_CHAT_PER_MINUTE=12
